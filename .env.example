# Groq API キー。サーバ側でのみ使用する（ブラウザには絶対に出さない）
# 取得: https://console.groq.com → API Keys → Create API Key（無料・カード登録不要）
# このファイルはテンプレート。実値は .env.local にコピーして書く（.env.local はGit管理外）
GROQ_API_KEY=

# 使用モデル（任意）。無料枠で叩けるモデル名に変更してよい
# 例: llama-3.1-8b-instant（軽量・IPIが通りやすい） / llama-3.3-70b-versatile（高性能）
GROQ_MODEL=llama-3.1-8b-instant
